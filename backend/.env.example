# Supabase: '#' in the password MUST be %23.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
ENVIRONMENT=development

# openssl rand -hex 32
USER_SECRET=

# console.cloud.google.com > Credentials > OAuth client (Web application)
#   Authorized JS origin:   http://localhost:5173
#   Authorized redirect:    http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Full control, and always able to sign in. Everyone else needs an
# active members row whose email matches their Google account.
SUPERADMIN_EMAILS=you@hackerearth.com,someone@hackerearth.com

# Shared secret for POST /api/intake/slack
INTAKE_TOKEN=

JIRA_BASE_URL=https://hackerearth.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

SLACK_BOT_TOKEN=
SLACK_CHANNEL=content-dashboard

# Creating and transitioning Jira issues. Off unless you mean it.
JIRA_WRITES_ENABLED=false
SLACK_WRITES_ENABLED=false

# Gmail SMTP for the 11am plan reminder
EMAIL_ENABLED=false
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
SUPPORT_EMAIL=

# Utils > MCQ Reviewer. OpenAI is primary, Anthropic is the fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# smith.langchain.com — traces both providers' calls under this project.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mcq-reviewer
