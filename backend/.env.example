# Supabase: '#' in the password MUST be %23.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
ENVIRONMENT=development

# openssl rand -hex 32
USER_SECRET=

# console.cloud.google.com > Credentials > OAuth client (Web application)
#   Authorized JS origin:   http://localhost:5173
#   Authorized redirect:    http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Comma-separated. Empty means any Google account may sign in.
ALLOWED_EMAILS=

# Shared secret for POST /api/intake/slack
INTAKE_TOKEN=

JIRA_BASE_URL=https://hackerearth.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

SLACK_BOT_TOKEN=
SLACK_CHANNEL=content-dashboard
